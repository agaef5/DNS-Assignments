@using Components
@using DTOs.Comments

<div class="flex-column justify-content-around border-dark-subtle rounded-1">
    <div class="py-2">
        <div class="">
            @Username
        </div>
        <h2>@Title</h2>
    </div>
    <p class="">@Body</p>
</div>

@code {
    [Parameter]
    public int PostId { get; set; }
    
    [Parameter]
    public int UserId { get; set; }
    
    [Parameter]
    public required string Username { get; set; } 
    
    [Parameter]
    public required string Title { get; set; }
    
    [Parameter]
    public required string Body { get; set; }
    
} 