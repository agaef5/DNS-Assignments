@page "/"
@inject NavigationManager NavManager

<PageTitle>Home</PageTitle>

<h1>Some weird forum</h1>

<AuthorizeView>
    <Authorized>
        <button @onclick="@(() => NavManager.NavigateTo("/posts"))">Click here to see all posts</button>
    </Authorized>
    <NotAuthorized>
        <div>bro, u need to log in</div>
        <button @onclick="@(() => NavManager.NavigateTo("/login"))">Do it here</button>
    </NotAuthorized>
</AuthorizeView>
