@using ClientApp.Services.Auth
@using ClientApp.Services.Comment
@using ClientApp.Services.Post
@using DTOs.Comments
@using DTOs.Posts
@inject AuthenticationStateProvider AuthenticationProvider
@inject IPostService PostService;
@inject ICommentService CommentService;
@page "/posts/{Id:int}"


@if (PostDto is null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <div>
        <Post PostId="Id" UserId="@PostDto.UserId" Username="@PostDto.Username" Title="@PostDto.Title" Body="@PostDto.Body"/>

        <AuthorizeView>
            <NotAuthorized>
                <div class="flex-column row border-dark-subtle">
                    <InputText @bind-Value="NewComment"></InputText>
                    <button class="w-25" @onclick="CreateNewComment">Comment</button>
                </div>
            </NotAuthorized>
        </AuthorizeView>


        @foreach (CommentDto comment in CommentDtos)
        {
            <Comment CommentId="@comment.Id" UserId="@comment.UserId"
                     Username="@comment.Username" Body="@comment.Body"/>
        }
    </div> 
}

@code {
    [Parameter] public int Id { get; set; }

    private PostDto? PostDto { get; set; }
    private List<CommentDto>? CommentDtos { get; set; }
    private string NewComment { get; set; } = "";

    protected override async Task OnParametersSetAsync()
    {
        PostDto = await PostService.GetPostByIdAsync(Id);
        CommentDtos = PostDto?.Comments ?? new List<CommentDto>();
    }

    private async Task CreateNewComment()
    {
        if (string.IsNullOrWhiteSpace(NewComment))
            return;

        var authenticationState = await AuthenticationProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        int userId = Convert.ToInt32(user.FindFirst("Id")); 

        var newCommentDto = new CreateCommentDto(NewComment, Id, userId);
        
        CommentDto created = await CommentService.CreateCommentAsync(newCommentDto);

        CommentDtos.Add(created);
        NewComment = string.Empty;
    }

}