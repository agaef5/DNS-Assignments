@page "/login"
@inject AuthenticationStateProvider AuthenticationProvider
@inject NavigationManager NavManager
@using ClientApp.Services.Auth
@using DTOs
@rendermode InteractiveServer

<PageTitle>Login</PageTitle>

<p>Username:</p>
<input class="username-field" @bind="@username">

<p>Password:</p>
<input class="password-field" @bind="@password">

<p class="text-bg-warning">@errorLabel</p>
<br/>

<button class="btn btn-outline-primary" @onclick="SendLoginRequest">Log in</button>

<a class="link-underline" @onclick="@(()=> NavManager.NavigateTo("/register"))" >Register here</a>
@code{
    
    private AuthUserDto _userDto;
    private string username = "";
    private string password = "";
    private string errorLabel = "";


    private async Task SendLoginRequest()
    {
        errorLabel = "";
        try
        {
            await ((AuthProvider)AuthenticationProvider).Login(username, password);
            NavManager.NavigateTo("/Posts");
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            errorLabel = $"Error: {e.Message}";
        }
    }
    

}