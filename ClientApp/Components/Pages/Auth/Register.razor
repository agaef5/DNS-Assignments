@page "/register"
@inject AuthenticationStateProvider AuthenticationProvider
@inject NavigationManager NavManager
@using ClientApp.Services.Auth
@using ClientApp.Services.User
@using DTOs
@rendermode InteractiveServer

<PageTitle>Create account</PageTitle>

<p>Username:</p>
<input class="username-field" @bind="username">

<p>Password:</p>
<input class="password-field" @bind="password">

<p class="text-bg-warning">@errorLabel</p>
<br/>

<button class="btn btn-outline-primary" @onclick="SendRegisterRequest">Sign in</button>

<a class="link-underline" href="@(() => NavManager.NavigateTo("/Posts") )">Login here</a>

@code{
    
    private AuthUserDto _userDto;
    private string username = "";
    private string password = "";
    private string errorLabel = "";


    private async Task SendRegisterRequest()
    {
        errorLabel = "";
        try
        {
            await ((AuthProvider)AuthenticationProvider).Login(username, password);
            NavManager.NavigateTo("/Posts");
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            errorLabel = $"Error: {e.Message}";
        }
        
        
    }
    

}